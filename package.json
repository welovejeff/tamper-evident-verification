{
  "name": "tamper-signal",
  "version": "1.5.0",
  "description": "Signed receipts for vibe-coded data pipelines. Proves nobody changed your data, and shows the exact link if they did.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://tampersignal.com/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/welovejeff/tamper-evident-verification.git"
  },
  "exports": {
    ".": "./node/index.js",
    "./light": "./badge/light.js",
    "./badge": "./badge/badge.js",
    "./element": "./badge/element.js",
    "./table": "./badge/table.js",
    "./console": "./badge/console.js",
    "./express": "./node/express.js",
    "./react": "./badge/light-react.js"
  },
  "bin": {
    "tamper-signal": "node/cli.js"
  },
  "files": [
    "node/",
    "badge/badge.js",
    "badge/light.js",
    "badge/element.js",
    "badge/table.js",
    "badge/console.js",
    "badge/light-react.js",
    "AGENTS.md"
  ],
  "scripts": {
    "test": "node --test node/test/canonical.test.js node/test/chain.test.js node/test/interop.test.js node/test/express.test.js"
  },
  "engines": {
    "node": ">=18.17"
  },
  "peerDependencies": {
    "react": ">=17"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "keywords": [
    "tamper-evident",
    "data-integrity",
    "provenance",
    "ed25519",
    "signed-receipts",
    "data-pipelines",
    "verification",
    "hash-chain"
  ]
}
