{
  "name": "tamper-signal",
  "version": "2.1.0",
  "description": "Signed receipts for vibe-coded data pipelines. Proves nobody changed your data, and shows the exact link if they did.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://tampersignal.com/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/welovejeff/tamper-evident-verification.git"
  },
  "exports": {
    ".": {
      "types": "./node/index.d.ts",
      "default": "./node/index.js"
    },
    "./light": {
      "types": "./badge/light.d.ts",
      "default": "./badge/light.js"
    },
    "./badge": {
      "types": "./badge/badge.d.ts",
      "default": "./badge/badge.js"
    },
    "./element": {
      "types": "./badge/element.d.ts",
      "default": "./badge/element.js"
    },
    "./table": {
      "types": "./badge/table.d.ts",
      "default": "./badge/table.js"
    },
    "./console": {
      "types": "./badge/console.d.ts",
      "default": "./badge/console.js"
    },
    "./room": {
      "types": "./badge/room.d.ts",
      "default": "./badge/room.js"
    },
    "./express": {
      "types": "./node/express.d.ts",
      "default": "./node/express.js"
    },
    "./react": {
      "types": "./badge/light-react.d.ts",
      "default": "./badge/light-react.js"
    }
  },
  "bin": {
    "tamper-signal": "node/cli.js"
  },
  "files": [
    "node/",
    "types/",
    "badge/badge.js",
    "badge/badge.d.ts",
    "badge/light.js",
    "badge/light.d.ts",
    "badge/element.js",
    "badge/element.d.ts",
    "badge/table.js",
    "badge/table.d.ts",
    "badge/console.js",
    "badge/console.d.ts",
    "badge/room.js",
    "badge/room.d.ts",
    "badge/light-react.js",
    "badge/light-react.d.ts",
    "AGENTS.md"
  ],
  "scripts": {
    "test": "node --test node/test/badge.test.js node/test/canonical.test.js node/test/chain.test.js node/test/interop.test.js node/test/express.test.js node/test/totals.test.js node/test/pipeline.test.js node/test/history.test.js node/test/diff.test.js node/test/log.test.js node/test/judgment.test.js node/test/theme.test.js node/test/zip.test.js node/test/append_period.test.js node/test/color.test.js node/test/json_surface.test.js node/test/cli_color.test.js node/test/annotations.test.js node/test/timeline.test.js node/test/vocab.test.js node/test/verify_memo.test.js node/test/room_state.test.js node/test/vendored_skew.test.js node/test/stale_table.test.js"
  },
  "engines": {
    "node": ">=18.17"
  },
  "peerDependencies": {
    "react": ">=17"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "keywords": [
    "tamper-evident",
    "data-integrity",
    "provenance",
    "ed25519",
    "signed-receipts",
    "data-pipelines",
    "verification",
    "hash-chain"
  ]
}
